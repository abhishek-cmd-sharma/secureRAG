# ==============================================================================
# SecureRAG — Root & Docker Compose Environment Template
# Safe configuration placeholders for production and local deployment
# ==============================================================================

# --- Node & Runtime Environment ---
NODE_ENV=production
PORT=5000

# --- Database Credentials (MongoDB Atlas) ---
# Replace with your Atlas connection string (never commit credentials!)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/securerag?retryWrites=true&w=majority
ALLOW_MEMORY_DB=false

# --- Security & Authentication ---
# Generate with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# --- Google Gemini AI Credentials ---
# Acquire from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# --- Qdrant Vector Database ---
# For Docker Compose internal networking:
QDRANT_URL=http://qdrant:6333
# For standalone local run without Docker Compose:
# QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=securerag_chunks

# --- CORS & Client Origin ---
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173

# --- Frontend Client Build Environment (Vite) ---
# When deployed behind Nginx reverse proxy, use '/api'
# For standalone frontend pointing directly to backend: 'http://localhost:5000/api'
VITE_API_URL=/api
