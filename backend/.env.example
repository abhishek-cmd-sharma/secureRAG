PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_super_secret_enterprise_token_key_here

# MongoDB Atlas Configuration
# Connection string example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/securerag?retryWrites=true&w=majority
MONGODB_URI=
# Set ALLOW_MEMORY_DB=true only for testing or offline local development when Atlas is unavailable.
# In production, this must be false or left unset.
ALLOW_MEMORY_DB=false

# Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gemini Embeddings Configuration
# Official current text embedding model is gemini-embedding-001 (or models/gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Embedding dimension configured on Qdrant collection and Gemini outputDimensionality
EMBEDDING_DIMENSION=768

# Qdrant Vector Database Configuration
# Start local Qdrant via Docker: docker run -p 6333:6333 -v $(pwd)/qdrant_storage:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=securerag_chunks
# Allow in-memory fallback vector engine if Qdrant is unreachable during development
ALLOW_MEMORY_VECTOR=true

# Storage & Retrieval Parameters
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.20
